<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly (Monday 03:00). Ideas don't accrue daily, and weekly cadence
     enforces the tier quota naturally. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.{{USER}}.godscout</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.god-agents/run-scout.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>{{HOME}}/.god-agents/logs/launchd-scout.out</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/.god-agents/logs/launchd-scout.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
